[Unit]
Description=Laporan pagi: runtime untuk kantor 3D (127.0.0.1:8711)
After=network-online.target

[Service]
User=laporan
Group=laporan
WorkingDirectory=/opt/laporan
EnvironmentFile=/etc/laporan/laporan.env
ExecStart=/opt/laporan/.venv/bin/laporan runtime --port 8711
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
